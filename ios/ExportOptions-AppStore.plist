<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribution method for App Store -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Team ID (replace with your actual Team ID) -->
	<key>teamID</key>
	<string>CFRXH38L48</string>

	<!-- Upload to App Store Connect -->
	<key>destination</key>
	<string>upload</string>

	<!-- Signing style -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Manage version and build number automatically -->
	<key>manageAppVersionAndBuildNumber</key>
	<true/>

	<!-- Upload symbols for crash reporting -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Generate app store information -->
	<key>generateAppStoreInformation</key>
	<false/>

	<!-- Strip Swift symbols -->
	<key>stripSwiftSymbols</key>
	<true/>

	<!-- Provisioning profiles (automatic signing will handle this) -->
	<key>provisioningProfiles</key>
	<dict>
		<key>ai.n42.www</key>
		<string>match AppStore ai.n42.www</string>
	</dict>
</dict>
</plist>
