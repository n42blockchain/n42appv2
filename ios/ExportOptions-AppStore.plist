<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribution method for App Store -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Team ID (replace with your actual Team ID) -->
	<key>teamID</key>
	<string>CFRXH38L48</string>

	<!-- Export locally; upload is a separate release operation. -->
	<key>destination</key>
	<string>export</string>

	<!-- Signing style -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Preserve the version tested and committed in pubspec.yaml. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- Upload symbols for crash reporting -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Generate app store information -->
	<key>generateAppStoreInformation</key>
	<false/>

	<!-- Strip Swift symbols -->
	<key>stripSwiftSymbols</key>
	<true/>


</dict>
</plist>
