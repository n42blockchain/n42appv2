<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>N42Wallet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>N42Wallet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>astranet.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>astraapp</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>ai.n42.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>n42</string>
				<string>n42app</string>
			</array>
		</dict>
	</array>
	<key>N42ChatGoogleClientID</key>
	<string>$(N42_CHAT_GOOGLE_CLIENT_ID)</string>
	<key>N42ChatGoogleServerClientID</key>
	<string>$(N42_CHAT_GOOGLE_SERVER_CLIENT_ID)</string>
	<key>N42ChatTwitterApiKey</key>
	<string>$(N42_CHAT_TWITTER_API_KEY)</string>
	<key>N42ChatTwitterApiSecret</key>
	<string>$(N42_CHAT_TWITTER_API_SECRET)</string>
	<key>N42ChatTwitterRedirectUri</key>
	<string>$(N42_CHAT_TWITTER_REDIRECT_URI)</string>
	<key>N42ChatWeChatAppID</key>
	<string>$(N42_CHAT_WECHAT_APP_ID)</string>
	<key>N42ChatWeChatUniversalLink</key>
	<string>$(N42_CHAT_WECHAT_UNIVERSAL_LINK)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>weixinULAPI</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- DApp browser requires loading arbitrary web content (HTTP/HTTPS) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>N42 Wallet needs access to Apple Music to play audio content in chat messages.</string>
	<key>NSCameraUsageDescription</key>
	<string>N42 Wallet needs camera access to scan QR codes for wallet addresses and WalletConnect, and to capture photos for your profile picture.</string>
	<key>NSContactsUsageDescription</key>
	<string>N42 Wallet needs access to your contacts to help you find and connect with friends.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>N42 Wallet uses Face ID and Touch ID to securely authenticate and protect your wallet access.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>N42 Wallet needs continuous location access to share live location with contacts in chat conversations.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>N42 Wallet needs location access to share your location with contacts in chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>N42 Wallet needs microphone access to record voice messages in chat and for voice/video calls.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>N42 Wallet needs permission to save QR codes and images to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>N42 Wallet needs photo library access to select images for your profile picture and to share files in chat.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
