# Uncomment this line to define a global platform for your project
 platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod  'TrustWalletCore', '4.6.8'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler: 显式启用 iOS 需要的权限类型
    if target.name == 'permission_handler_apple'
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_MICROPHONE=1'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CONTACTS=1'
      end
    end

    target.build_configurations.each do |config|
      # 确保所有 pod 都使用 iOS 16.0 作为最低部署目标
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # 统一 Swift 版本为 5.0
      config.build_settings['SWIFT_VERSION'] = '5.0'
      # 修复 Swift 编译问题
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      # 只排除 i386 架构，保留 arm64 用于 Apple Silicon 模拟器
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
      # 使用 classic 链接器避免 clang linker segfault
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -ld_classic'

      # Fix fluwx WXApi.h not found issue for simulator builds
      if target.name == 'fluwx'
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_XCFRAMEWORKS_BUILD_DIR}/WechatOpenSDK-XCFramework/WechatOpenSDK.framework/Headers"'
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"${PODS_XCFRAMEWORKS_BUILD_DIR}/WechatOpenSDK-XCFramework"'
      end
    end
  end

  # Configure main project for simulator support
  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |variant, xcconfig|
      xcconfig.save_as(Pathname.new("#{installer.sandbox.root}/Target Support Files/#{target.name}/#{variant}.xcconfig"))
    end
  end

  # Modify Runner target to exclude MobileSdk on simulator
  runner_project = installer.aggregate_targets.first.user_project
  runner_project.targets.each do |target|
    if target.name == 'Runner'
      target.build_configurations.each do |config|
        # MLImage.framework (Google MLKit) has no arm64 simulator slice — use Rosetta (x86_64)
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'

        # Exclude MobileSdk.xcframework linking on simulator
        # The Swift code uses #if targetEnvironment(simulator) to provide mock implementations
        xcconfig_path = config.base_configuration_reference&.real_path
        if xcconfig_path && File.exist?(xcconfig_path)
          xcconfig = File.read(xcconfig_path)
          # Add preprocessor macro to indicate simulator build
          unless xcconfig.include?('SWIFT_ACTIVE_COMPILATION_CONDITIONS')
            File.open(xcconfig_path, 'a') do |file|
              file.puts "\n// Simulator detection for MobileSdk"
              file.puts "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator*] = $(inherited) SIMULATOR_BUILD"
            end
          end
        end
      end

      # Fix: add Run Script phase to create missing Info.plist for embedded frameworks (e.g., objective_c.framework)
      existing_fix = target.build_phases.find { |p|
        p.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) &&
        p.name == '[Fix] Missing framework Info.plist'
      }
      unless existing_fix
        phase = runner_project.new(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        phase.name = '[Fix] Missing framework Info.plist'
        phase.shell_script = <<~'SCRIPT'
          find "$BUILT_PRODUCTS_DIR/$FRAMEWORKS_FOLDER_PATH" -name "*.framework" | while read fw; do
            plist="$fw/Info.plist"
            if [ ! -f "$plist" ]; then
              name=$(basename "$fw" .framework)
              /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string org.grpc.$name" \
                -c "Add :CFBundleInfoDictionaryVersion string 6.0" \
                -c "Add :CFBundlePackageType string FMWK" \
                -c "Add :CFBundleShortVersionString string 1.0" \
                -c "Add :CFBundleVersion string 1" \
                "$plist" 2>/dev/null || true
            fi
          done
        SCRIPT
        # Insert after "Embed Frameworks" phase
        embed_idx = target.build_phases.index { |p|
          p.is_a?(Xcodeproj::Project::Object::PBXCopyFilesBuildPhase) ||
          (p.respond_to?(:name) && p.name.to_s.include?('Embed'))
        }
        if embed_idx
          target.build_phases.insert(embed_idx + 1, phase)
        else
          target.build_phases << phase
        end
      end
    end
  end
  runner_project.save
end
