+}
+
+fn clear_error(out_error: *mut *mut c_char) {
+    if !out_error.is_null() {
+        unsafe { *out_error = ptr::null_mut(); }
+    }
+}
+
+fn result_c_string(s: String, out_error: *mut *mut c_char) -> *mut c_char {
+    match CString::new(s) {
+        Ok(result) => result.into_raw(),
+        Err(_) => {
+            if !out_error.is_null() {
+                unsafe { *out_error = make_c_string("response contains NUL byte".to_owned()); }
+            }
+            ptr::null_mut()
+        }
+    }
+}
+
+fn new_runtime_with<F>(factory: F) -> std::result::Result<tokio::runtime::Runtime, String>
+where
+    F: FnOnce() -> std::io::Result<tokio::runtime::Runtime>,
+{
+    factory().map_err(|error| format!("runtime initialization failed: {error}"))
 }
 
