+#[cfg(test)]
+mod apple_ffi_tests {
+    use super::*;
+
+    #[test]
+    fn invalid_exit_fee_returns_only_error() {
+        let pubkey = CString::new("0x8a2470d8ccb2e43b3b5295cfee71508f8808e166e5f152d5af9fe022d95e300dc7c5814f2c9eb71e2da8412beb61c53a").unwrap();
+        let fee = CString::new("not-a-fee").unwrap();
+        let mut error = ptr::null_mut();
+        let result = create_exit_unsigned_tx_c(pubkey.as_ptr(), fee.as_ptr(), &mut error);
+        let message = if error.is_null() { None } else { Some(unsafe { CStr::from_ptr(error).to_string_lossy().into_owned() }) };
+        rust_free_string(result);
+        rust_free_string(error);
+        assert!(result.is_null(), "invalid fee returned a transaction");
+        assert_eq!(message.as_deref(), Some("invalid fee"));
+    }
+
+    #[test]
+    fn successful_exit_fee_call_clears_prior_error_slot() {
+        let stale = CString::new("stale").unwrap().into_raw();
+        let mut error = stale;
+        let result = create_get_exit_fee_unsigned_tx_c(&mut error);
+        let clean = error.is_null();
+        rust_free_string(result);
+        if error != stale { rust_free_string(error); }
+        rust_free_string(stale);
+        assert!(!result.is_null());
+        assert!(clean, "successful C call left a stale error pointer");
+    }
+
+    #[test]
+    fn interior_nul_does_not_panic_when_making_c_string() {
+        let result = std::panic::catch_unwind(|| make_c_string("a\0b".to_owned()));
+        if let Ok(pointer) = &result { rust_free_string(*pointer); }
+        assert!(result.is_ok());
+    }
+
+    #[test]
+    fn runtime_constructor_failure_is_returned_as_error() {
+        let result = new_runtime_with(|| {
+            Err(std::io::Error::other("synthetic runtime failure"))
+        });
+        assert_eq!(
+            result.err().as_deref(),
+            Some("runtime initialization failed: synthetic runtime failure")
+        );
+    }
+
+    #[test]
+    fn null_run_client_input_returns_before_runtime_or_network() {
+        let mut error = ptr::null_mut();
+        let code = run_client_c(ptr::null(), ptr::null(), &mut error);
+        let message = unsafe { CStr::from_ptr(error).to_string_lossy().into_owned() };
+        rust_free_string(error);
+        assert_eq!(code, -1);
+        assert_eq!(message, "null pointer");
+    }
+
+    #[test]
+    fn invalid_exit_fee_without_error_slot_returns_no_transaction() {
+        let pubkey = CString::new("0x8a2470d8ccb2e43b3b5295cfee71508f8808e166e5f152d5af9fe022d95e300dc7c5814f2c9eb71e2da8412beb61c53a").unwrap();
+        let fee = CString::new("not-a-fee").unwrap();
+        let result = create_exit_unsigned_tx_c(pubkey.as_ptr(), fee.as_ptr(), ptr::null_mut());
+        rust_free_string(result);
+        assert!(result.is_null());
+    }
+
+    #[test]
+    fn malformed_block_returns_error_before_runtime() {
+        let block = CString::new("not-json").unwrap();
+        let key = CString::new("synthetic").unwrap();
+        let mut error = ptr::null_mut();
+        let result = gen_block_verify_result_c(block.as_ptr(), key.as_ptr(), &mut error);
+        let message = unsafe { CStr::from_ptr(error).to_string_lossy().into_owned() };
+        rust_free_string(result);
+        rust_free_string(error);
+        assert!(result.is_null());
+        assert!(!message.is_empty());
+    }
+}
