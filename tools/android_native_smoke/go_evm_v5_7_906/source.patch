+		"type": "blspubk",
+		"val": map[string]string{"priv_key": secret},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, output := captureEmitStdout(t, string(request))
+	if !strings.Contains(response, `"code":0`) {
+		t.Fatalf("blspubk failed: %s", response)
+	}
+	if strings.Contains(output, secret) {
+		t.Fatal("Emit printed BLS request private key")
+	}
+}
