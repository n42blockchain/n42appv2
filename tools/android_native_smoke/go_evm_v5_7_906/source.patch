--- a/cmd/evmsdk/emit_secret_log_test.go
+++ b/cmd/evmsdk/emit_secret_log_test.go
@@ -0,0 +1,72 @@
+package evmsdk
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func captureEmitStdout(t *testing.T, request string) (string, string) {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	previous := os.Stdout
+	os.Stdout = writer
+	defer func() {
+		os.Stdout = previous
+		reader.Close()
+	}()
+	response := Emit(request)
+	writer.Close()
+	output, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return response, string(output)
+}
+
+func TestEmitDoesNotLogPrivateKeyBeforeInitialSetting(t *testing.T) {
+	secret := strings.Repeat("ab", 32)
+	oldEngine, oldDebug := EE, isDebug
+	EE, isDebug = &EvmEngine{}, true
+	defer func() { EE, isDebug = oldEngine, oldDebug }()
+	request, err := json.Marshal(map[string]interface{}{
+		"type": "setting",
+		"val": map[string]string{"priv_key": secret, "log_level": ""},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, output := captureEmitStdout(t, string(request))
+	if !strings.Contains(response, `"code":0`) {
+		t.Fatalf("setting failed: %s", response)
+	}
+	if strings.Contains(output, secret) {
+		t.Fatal("Emit printed initial private key before applying log level")
+	}
+}
+
+func TestEmitDoesNotLogBlsRequestPrivateKey(t *testing.T) {
+	secret := strings.Repeat("cd", 32)
