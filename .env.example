# ============================================================
# N42 Wallet — Environment Variables
# ============================================================
# cp .env.example .env   (then fill in real values)
# DO NOT commit .env to version control
#
# Usage:
#   flutter run  $(cat .env | grep -v '^#' | grep -v '^$' | sed 's/^/--dart-define=/')
#   or in CI/CD: set each variable as environment variable before build

# ==================== Ethereum / Infura ====================
INFURA_API_KEY=
INFURA_SEPOLIA_KEY=

# ==================== Block Explorer APIs ====================
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
SONICSCAN_API_KEY=

# ==================== TON (The Open Network) ====================
TON_API_KEY_MAINNET=
TON_API_KEY_TESTNET=

# ==================== Polkadot / Subscan ====================
DOT_API_KEY=

# ==================== Price / NFT Data ====================
COINGECKO_API_KEY=
SIMPLE_HASH_API_KEY=

# ==================== MoonPay (Fiat On-Ramp) ====================
MOONPAY_SECRET_KEY=
MOONPAY_SECRET_KEY_TEST=

# ==================== AI Service ====================
# Groq / OpenAI / DeepSeek compatible
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.3-70b-versatile

# ==================== API Proxy ====================
PROXY_BASE_URL=https://api.n42.ai/proxy
PROXY_AUTH_TOKEN=

# ==================== Mining Node ====================
MINING_WS_URL=wss://ws.n42.world
MINING_RPC_URL=https://rpc.n42.world
MINING_EXPLORER_URL=https://testnet2.n42.world

# ==================== Chain RPC Overrides ====================
N42_TESTNET_RPC=https://testrpc.n42.world
ETH_RPC_URL=https://rpc.n42.world
BTC_TESTNET_RPC=https://198.200.30.38:18001
BTC_MAINNET_RPC=https://198.200.30.34:18002

# ==================== IPFS ====================
IPFS_USERNAME=
IPFS_PASSWORD=

# ==================== Account Abstraction ====================
BUNDLER_API_KEY=

# ==================== Feature Flags ====================
# FEATURE_DOT_STAKING=false
