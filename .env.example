# N42 Wallet API Keys Configuration
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control

# Infura (Ethereum RPC)
INFURA_API_KEY=your_infura_api_key_here
INFURA_SEPOLIA_KEY=your_infura_sepolia_key_here

# Block Explorer APIs
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BSCSCAN_API_KEY=your_bscscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here
SONICSCAN_API_KEY=your_sonicscan_api_key_here

# AI Service (Groq / OpenAI / DeepSeek compatible)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.3-70b-versatile

# Mining Node
MINING_WS_URL=ws://your-mining-node:8546/
MINING_RPC_URL=http://your-mining-node:8545

# BTC RPC Endpoints
BTC_TESTNET_RPC=https://your-btc-testnet-rpc:18001
BTC_MAINNET_RPC=https://your-btc-mainnet-rpc:18002

# IPFS Credentials
IPFS_USERNAME=your_ipfs_username
IPFS_PASSWORD=your_ipfs_password

# Bundler (Account Abstraction)
BUNDLER_API_KEY=your_bundler_api_key

# Usage:
# Development: flutter run --dart-define=INFURA_API_KEY=xxx --dart-define=ETHERSCAN_API_KEY=xxx --dart-define=AI_API_KEY=xxx
# Production:  Set environment variables in CI/CD pipeline