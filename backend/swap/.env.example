# DEX Swap Service — 环境变量示例
# 复制为 .env 并填入真实值，不要提交 .env 到 git

PORT=8080

# PostgreSQL 连接串
DB_DSN=postgres://user:password@localhost:5432/n42swap?sslmode=disable

# 1inch Aggregation Protocol v6 API Key
# 申请地址：https://portal.1inch.dev/
INCH_API_KEY=your-1inch-api-key-here

# EVM 链 RPC 节点
ETH_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
BSC_RPC=https://bsc-dataseed.binance.org
POLYGON_RPC=https://polygon-rpc.com
ARB_RPC=https://arb1.arbitrum.io/rpc
OP_RPC=https://mainnet.optimism.io

# Solana RPC（Jupiter 不需要，但 monitor 链上查询需要）
SOL_RPC=https://api.mainnet-beta.solana.com
