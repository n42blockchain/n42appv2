<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置 - Google Play 合规
  - 默认禁止明文流量 (HTTP)
  - 仅允许特定域名的明文流量 (开发/测试需要)
-->
<network-security-config>
    <!-- 默认配置：仅允许 HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 开发环境例外：允许本地调试 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- N42 测试节点 (仅开发阶段，正式发布前应移除或改用 HTTPS) -->
        <domain includeSubdomains="true">5.161.252.59</domain>
        <domain includeSubdomains="true">54.243.83.152</domain>
        <domain includeSubdomains="true">18.170.108.78</domain>
    </domain-config>
</network-security-config>
